# Local development example. Copy to `.env` (never commit `.env`).
#
# Production checklist (process will refuse to boot otherwise):
#   DJANGO_ENV=production
#   DEBUG=False
#   SECRET_KEY=<unique value, 32+ chars, not containing "insecure">
#   ALLOWED_HOSTS=api.example.com
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
#   PAYMENT_GATEWAY=zarinpal   # mock is rejected when DEBUG=False
#   SECURE_SSL_REDIRECT=True
#   SESSION_COOKIE_SECURE=True
#   CSRF_COOKIE_SECURE=True
#   SECURE_HSTS_SECONDS=31536000
#   SERVE_MEDIA=False
#   CORS_ALLOWED_ORIGINS=https://app.example.com

DEBUG=True
DJANGO_ENV=development
SECRET_KEY=django-insecure-local-dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TIME_ZONE=Asia/Tehran

# Leave unset to use SQLite at ./db.sqlite3
# DATABASE_URL=postgres://schematics:schematics@127.0.0.1:5432/schematics

# Optional overrides (defaults live next to manage.py)
# MEDIA_ROOT=
# PROTECTED_MEDIA_ROOT=

# Optional Redis for shared rate-limit counters across gunicorn workers
# CACHE_URL=redis://127.0.0.1:6379/1

SERVE_MEDIA=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

CSRF_TRUSTED_ORIGINS=https://*.app.github.dev,https://*.githubpreview.dev

# Comma-separated browser origins allowed to call /api/v1/ (Vite, Next, Expo web).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# Payments (mock until Zarinpal/IDPay merchant keys are set)
PAYMENT_GATEWAY=mock
PAYMENT_MOCK_SUCCESS=True
# PAYMENT_CALLBACK_URL=https://api.example.com/api/v1/payments/verify/
# PAYMENT_ZARINPAL_MERCHANT_ID=
# PAYMENT_IDPAY_API_KEY=
