# Local development example. Copy to `.env` (never commit `.env`).
#
# Production checklist:
#   DEBUG=False
#   SECRET_KEY=<long random value>
#   ALLOWED_HOSTS=api.example.com
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
#   SECURE_SSL_REDIRECT=True
#   SESSION_COOKIE_SECURE=True
#   CSRF_COOKIE_SECURE=True
#   SECURE_HSTS_SECONDS=31536000
#   SERVE_MEDIA=False

DEBUG=True
SECRET_KEY=django-insecure-local-dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TIME_ZONE=Asia/Tehran

# Leave unset to use SQLite at ./db.sqlite3
# DATABASE_URL=postgres://schematics:schematics@127.0.0.1:5432/schematics

# Optional overrides (defaults live next to manage.py)
# MEDIA_ROOT=
# PROTECTED_MEDIA_ROOT=

SERVE_MEDIA=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

CSRF_TRUSTED_ORIGINS=https://*.app.github.dev,https://*.githubpreview.dev

# Payments (mock until Zarinpal/IDPay merchant keys are set)
PAYMENT_GATEWAY=mock
PAYMENT_MOCK_SUCCESS=True
# PAYMENT_CALLBACK_URL=https://api.example.com/api/v1/payments/verify/
# PAYMENT_ZARINPAL_MERCHANT_ID=
# PAYMENT_IDPAY_API_KEY=
